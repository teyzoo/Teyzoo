from __future__ import annotations

from dataclasses import dataclass

from indicators import (
    calculate_indicators,
)

from market import Candle


@dataclass(slots=True)
class MarketCondition:
    tradable: bool
    volatility_ok: bool
    trend_ok: bool
    data_ok: bool

    reasons: list[str]


def evaluate_market_conditions(
    candles: list[Candle],
) -> MarketCondition:

    reasons: list[str] = []

    if len(candles) < 100:

        return MarketCondition(
            tradable=False,
            volatility_ok=False,
            trend_ok=False,
            data_ok=False,
            reasons=[
                "Недостаточно исторических данных."
            ],
        )

    indicators = (
        calculate_indicators(
            candles
        )
    )

    data_ok = True

    volatility_ok = True

    trend_ok = True

    # Проверка ATR.
    if indicators.atr is None:

        volatility_ok = False

        reasons.append(
            "ATR недоступен."
        )

    # Проверка EMA.
    if (
        indicators.ema_fast is None
        or indicators.ema_slow is None
    ):

        trend_ok = False

        reasons.append(
            "EMA недоступны."
        )

    # Проверяем последние свечи.
    recent = candles[-10:]

    if len(recent) < 10:

        data_ok = False

        reasons.append(
            "Недостаточно последних свечей."
        )

    # Защита от одинаковых цен.
    unique_prices = {
        candle.close
        for candle in recent
    }

    if len(unique_prices) <= 2:

        volatility_ok = False

        reasons.append(
            "Рынок практически не движется."
        )

    if not reasons:

        reasons.append(
            "Рыночные условия допустимы."
        )

    tradable = (
        data_ok
        and volatility_ok
        and trend_ok
    )

    return MarketCondition(
        tradable=tradable,
        volatility_ok=volatility_ok,
        trend_ok=trend_ok,
        data_ok=data_ok,
        reasons=reasons,
    )
